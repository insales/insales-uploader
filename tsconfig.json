{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "noEmitOnError": true,
    "declaration": true,
    "rootDir": "lib",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "skipLibCheck": false
  },
  "include": [
    "lib/**/*.ts"
  ]
}
