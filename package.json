{
  "name": "insales-uploader",
  "version": "2.0.0",
  "description": "InSales assets manager",
  "homepage": "https://github.com/insales/insales-uploader",
  "main": "dist/index.js",
  "bin": {
    "uploader": "bin/uploader.js"
  },
  "scripts": {
    "compile": "node scripts/compile.cjs",
    "prepare": "npm run compile",
    "test": "npm run compile && node --test test/*.test.cjs",
    "test:coverage": "npm run compile && node --test --experimental-test-coverage --test-coverage-include=dist/** --test-reporter=lcov --test-reporter-destination=coverage.lcov test/*.test.cjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.check.json",
    "test:package": "node scripts/test-package.cjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:package",
    "format": "prettier --write \"lib/**/*.ts\"",
    "format:check": "prettier --check \"lib/**/*.ts\""
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "insales",
    "insales.ru",
    "theme-uploader"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/insales/insales-uploader.git"
  },
  "license": "MIT",
  "author": "Ivanin Vladimir",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "@types/node-notifier": "^8.0.5",
    "@types/picomatch": "^4.0.2",
    "@types/progress": "^2.0.7",
    "@types/semver": "^7.7.1",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "prettier": "~3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "directories": {
    "lib": "lib"
  },
  "files": [
    "dist",
    "bin",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^15.0.0",
    "is-binary-buffer": "^2.0.0",
    "jszip": "^3.10.1",
    "node-notifier": "^12.1.0",
    "open": "^11.0.0",
    "picomatch": "^4.0.3",
    "progress": "^2.0.3",
    "semver": "^7.7.3",
    "upath": "^3.0.8"
  },
  "types": "dist/index.d.ts"
}
